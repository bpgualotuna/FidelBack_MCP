{
  "name": "fidel-back-mcp",
  "version": "1.0.0",
  "description": "Fidel Commercial AI Orchestrator & Clear Minds MCP Server (NestJS 11 + Prisma 7)",
  "author": "Clear Minds Consultores",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "tsc --noEmit",
    "test": "jest",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.6.1",
    "@nestjs/common": "11.0.10",
    "@nestjs/config": "4.0.0",
    "@nestjs/core": "11.0.10",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.0.10",
    "@nestjs/swagger": "11.0.5",
    "@prisma/adapter-pg": "6.4.1",
    "@prisma/client": "6.4.1",
    "bcrypt": "5.1.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "cookie-parser": "1.4.7",
    "dotenv": "16.4.7",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.13.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.4",
    "@nestjs/schematics": "11.0.0",
    "@nestjs/testing": "11.0.10",
    "@types/bcrypt": "5.0.2",
    "@types/cookie-parser": "1.4.8",
    "@types/express": "5.0.0",
    "@types/jest": "29.5.14",
    "@types/node": "22.13.5",
    "@types/passport-jwt": "4.0.1",
    "@types/pg": "8.11.11",
    "jest": "29.7.0",
    "prettier": "3.5.2",
    "prisma": "6.4.1",
    "source-map-support": "0.5.21",
    "ts-jest": "29.2.6",
    "ts-loader": "9.5.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "tsx": "4.19.3",
    "typescript": "5.7.3"
  }
}
